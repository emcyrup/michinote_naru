# =============================================
# 事業所「成」（職員向け）の .env の雛形（サーバーの ~/michinotenaru/.env に置く。Git には入れない。chmod 600）
#   開発 https://st-naru.ai-labo.cloud/ ・本番 https://naru.ai-labo.cloud/ → プロバイダ管理の nginx → Gunicorn 127.0.0.1:8049
#   Deploy (naru) の初回実行で、この雛形から自動で作られる（SECRET_KEY は生成。アドレス・ポート・DB 名・DB ユーザーは配備先（dev／prod）で決まる。
#   DB パスワードは Secrets の NARU_DEV_DB_PASSWORD／NARU_PROD_DB_PASSWORD から入る）
#   手順は docs/DEPLOY_NARU.md
# =============================================

# Django
SECRET_KEY=ここに50文字以上のランダム文字列（python -c "import secrets; print(secrets.token_urlsafe(50))"）
DEBUG=False
DJANGO_ALLOWED_HOSTS=NARU_DOMAIN_PLACEHOLDER
CSRF_TRUSTED_ORIGINS=https://NARU_DOMAIN_PLACEHOLDER
# nginx が X-Forwarded-Proto: https を付けていれば True。ログイン後に無限リダイレクトする場合は False にする
SECURE_SSL_REDIRECT=True
# 画面が読み込める先を絞る決まり（CSP）。画面がこわれたときだけ report（守らせず、コンソールに出すだけ）か off に
# CSP_MODE=enforce

# 保護者向け（app=family）だけ：Deploy (naru) が DJANGO_SETTINGS_MODULE=config.settings_family を足す（保護者の画面だけを出す設定）。
# 保護者向けの SECRET_KEY は、職員向けと同じ値（パスワード設定のリンクの署名に使うため。Deploy (naru) が初回に写す）

# Gunicorn（deploy/venv-deploy.sh が読む）。ポートはプロバイダから割り当てられた番号
PORT=0
GUNICORN_WORKERS=2

# PostgreSQL（サーバー上のプロバイダ管理 DB）
DB_NAME=NARU_DB_NAME_PLACEHOLDER
DB_USER=NARU_DB_USER_PLACEHOLDER
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# nginx を触れない環境なので写真は Django が配信する
# 写真・書類・ロゴの保存先（ホームディレクトリ内の絶対パスにする。ほかの環境の media とは別の場所）
# ~ は自分のホームに展開される。別ユーザーのホームなど作れないパスを書くと、~/michinotenaru/media に切り替えて警告が出る
MEDIA_ROOT=~/michinotenaru/media

# 保護者アプリ（別アプリ。メールアドレスとパスワードで入る）のアドレス。職員が出す「パスワード設定のリンク」の先頭になる
# （Deploy (naru) が配備先に合わせて入れる：開発 https://st-naru-family.ai-labo.cloud ／本番 https://naru-family.ai-labo.cloud）
FAMILY_APP_URL=

# 自己登録は使わない（事業所は Manage (naru) の create_facility で作る。職員の登録はログイン画面の「職員の新規登録」）
ALLOW_FACILITY_SIGNUP=False
SIGNUP_CODE=

# Anthropic Claude API（日誌の AI・個別支援計画の下書き・加算提案・書類の読み取り）
ANTHROPIC_API_KEY=
# 省略時: AI_PLAN_MODEL=claude-opus-5 / AI_TEXT_MODEL=claude-opus-5
#AI_TEXT_MODEL=claude-sonnet-5

# iPhone の音声入力（議事録・留意点など）で、音声を Google Cloud Speech-to-Text で文字にする
# Cloud Speech-to-Text API だけに制限した API キー。IP で制限するなら、このサーバーの IP を許可する（docs/RYOIKU_SERVER.md 3-7c）
GOOGLE_SPEECH_API_KEY=
# 配車表の所要時間に Google マップを使うとき（空なら国土地理院＋OSRM の無料の経路）
GOOGLE_MAPS_API_KEY=
# Google を使わず、サーバーの中で文字にする（faster-whisper）。モデル名を入れると配備時に部品が入り、最初の利用でモデルを取得する
# small=速い・medium=精度は上がるが遅い・kotoba-tech/kotoba-whisper-v2.0-faster=日本語向け
#WHISPER_MODEL=small
#WHISPER_THREADS=2

# LINE は施設設定の画面で事業所ごとに入れる（ここは空でよい）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 期限のお知らせのメール（python manage.py send_reminders を cron で毎朝実行）
# 空のままなら送れない（ホームの「お知らせ・アラート」だけ使う）。Gmail なら EMAIL_HOST=smtp.gmail.com、アプリ パスワードを EMAIL_HOST_PASSWORD に
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# メールに載せるリンクの先頭（send_reminders --base-url でも指定できる）
RESERVATION_SITE_URL=https://NARU_DOMAIN_PLACEHOLDER
